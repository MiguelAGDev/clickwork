{
  "info": {
    "name": "ClickWork - Applications",
    "_postman_id": "clickwork-newman-applications",
    "description": "Login propio como estudiante (aplica a la vacante semillada), despues como empresa (ve y actualiza la postulacion).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST /api/auth/login - estudiante semillado",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"estudiante.seed@newman.test\",\n  \"password\": \"Newman123\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has a JWT token', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.token).to.be.a('string').and.not.empty;",
              "    pm.environment.set('token', json.token);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /api/applications - postularse a la segunda vacante semillada",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"job_posting_id\": 2\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/applications", "host": ["{{baseUrl}}"], "path": ["api", "applications"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response has the new application id', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.data.id).to.be.a('number');",
              "    pm.environment.set('applicationId', json.data.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "[NEGATIVO] POST /api/applications - ya te postulaste (misma vacante)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"job_posting_id\": 2\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/applications", "host": ["{{baseUrl}}"], "path": ["api", "applications"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 409', function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "",
              "pm.test('Error says already applied', function () {",
              "    pm.expect(pm.response.json().message).to.include('already applied');",
              "});"
            ]
          }
        }
      ]
    },
