    {
      "name": "GET /api/applications/me - mis postulaciones",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/applications/me", "host": ["{{baseUrl}}"], "path": ["api", "applications", "me"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Includes the application just created', function () {",
              "    const json = pm.response.json();",
              "    const appId = parseInt(pm.environment.get('applicationId'), 10);",
              "    pm.expect(json.data.some(a => a.app_id === appId)).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
