{
  "info": {
    "name": "ClickWork - Auth",
    "_postman_id": "clickwork-newman-auth",
    "description": "register -> verify (token fijo del seed) -> login (guarda el JWT del estudiante semillado en {{token}} para users.json).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST /api/auth/register - nuevo estudiante",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nuevo.registro@newman.test\",\n  \"password\": \"Newman123\",\n  \"role\": \"student\",\n  \"semester\": 3,\n  \"careerId\": 1\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response has success: true', function () {",
              "    pm.expect(pm.response.json().success).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /api/auth/verify/:token - estudiante semillado",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/verify/a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "verify", "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has success: true', function () {",
              "    pm.expect(pm.response.json().success).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /api/auth/login - estudiante semillado",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"estudiante.seed@newman.test\",\n  \"password\": \"Newman123\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has a JWT token', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.token).to.be.a('string').and.not.empty;",
              "    pm.environment.set('token', json.token);",
              "});",
              "",
              "pm.test('Logged-in user is the seeded student', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.user.role).to.eql('student');",
              "});"
            ]
          }
        }
      ]
    },
    {
