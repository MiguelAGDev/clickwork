    {
      "name": "POST /api/auth/login - estudiante semillado",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"estudiante.seed@newman.test\",\n  \"password\": \"Newman123\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has a JWT token', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.token).to.be.a('string').and.not.empty;",
              "    pm.environment.set('token', json.token);",
              "});",
              "",
              "pm.test('Logged-in user is the seeded student', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.user.role).to.eql('student');",
              "});"
            ]
          }
        }
      ]
    },
