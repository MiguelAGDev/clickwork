{
  "info": {
    "name": "ClickWork - Auth",
    "_postman_id": "clickwork-newman-auth",
    "description": "register -> verify (token fijo del seed) -> login (guarda el JWT del estudiante semillado en {{token}} para users.json).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST /api/auth/register - nuevo estudiante",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nuevo.registro@newman.test\",\n  \"password\": \"Newman123\",\n  \"role\": \"student\",\n  \"semester\": 3,\n  \"careerId\": 1\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response has success: true', function () {",
              "    pm.expect(pm.response.json().success).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
