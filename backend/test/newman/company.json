{
  "info": {
    "name": "ClickWork - Company",
    "_postman_id": "clickwork-newman-company",
    "description": "Hace su propio login (empresa semillada) para sobreescribir {{token}} con un JWT de empresa antes de GET /api/company/me.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST /api/auth/login - empresa semillada",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"empresa.seed@newman.test\",\n  \"password\": \"Newman123\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has a JWT token', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.token).to.be.a('string').and.not.empty;",
              "    pm.environment.set('token', json.token);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /api/company/me - perfil de la empresa semillada",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/company/me", "host": ["{{baseUrl}}"], "path": ["api", "company", "me"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Returns the seeded, approved company', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.data.name).to.eql('Manufactura Digital de la Laguna');",
              "    pm.expect(json.data.approval_status).to.eql('approved');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT /api/company/me - editar perfil de empresa",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cmp_name\": \"Manufactura Digital de la Laguna\",\n  \"cmp_size\": \"medium\",\n  \"cmp_industry\": \"Software Development\",\n  \"cmp_city\": \"Torreón\",\n  \"cmp_state\": \"Coahuila\",\n  \"cmp_address\": \"Blvd. Independencia #900\",\n  \"cmp_contact_email\": \"contacto.seed@newman.test\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/company/me", "host": ["{{baseUrl}}"], "path": ["api", "company", "me"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has success: true', function () {",
              "    pm.expect(pm.response.json().success).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [ { "key": "baseUrl", "value": "http://localhost:3000" } ]
}
