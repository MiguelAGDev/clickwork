{
  "info": {
    "name": "ClickWork - Users",
    "_postman_id": "clickwork-newman-users",
    "description": "Usa {{token}} dejado por auth.json (login del estudiante semillado). GET/PUT /api/users/me.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "[NEGATIVO] GET /api/users/me - sin token",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/users/me", "host": ["{{baseUrl}}"], "path": ["api", "users", "me"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 401', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test('Error says no token provided', function () {",
              "    pm.expect(pm.response.json().message).to.include('No token provided');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "[NEGATIVO] GET /api/users/me - token invalido",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer esto-no-es-un-jwt-valido" } ],
        "url": { "raw": "{{baseUrl}}/api/users/me", "host": ["{{baseUrl}}"], "path": ["api", "users", "me"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 401', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test('Error says invalid or expired token', function () {",
              "    pm.expect(pm.response.json().message).to.include('Invalid or expired token');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /api/users/me - perfil del estudiante",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{baseUrl}}/api/users/me", "host": ["{{baseUrl}}"], "path": ["api", "users", "me"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Returns the seeded student with role-specific fields', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.data.email).to.eql('estudiante.seed@newman.test');",
              "    pm.expect(json.data.role).to.eql('student');",
              "    pm.expect(json.data.semester).to.eql(6);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT /api/users/me - actualizar telefono y semestre",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"8710009999\",\n  \"semester\": 7\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/users/me", "host": ["{{baseUrl}}"], "path": ["api", "users", "me"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Phone was updated', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.data.phone).to.eql('8710009999');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "[NEGATIVO] PUT /api/users/me - semestre fuera de rango",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"semester\": 99\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/users/me", "host": ["{{baseUrl}}"], "path": ["api", "users", "me"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 422 (express-validator)', function () {",
              "    pm.response.to.have.status(422);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /api/users/cv - subir CV",
      "request": {
        "method": "POST",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "cv", "type": "file", "src": "{{cvFilePath}}" }
          ]
        },
        "url": { "raw": "{{baseUrl}}/api/users/cv", "host": ["{{baseUrl}}"], "path": ["api", "users", "cv"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('cv_url was saved', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.data.cv_url).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "[NEGATIVO] POST /api/users/cv - sin archivo",
      "request": {
        "method": "POST",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "body": {
          "mode": "formdata",
          "formdata": []
