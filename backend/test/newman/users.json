              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "[NEGATIVO] POST /api/users/cv - archivo no es PDF",
      "request": {
        "method": "POST",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "body": {
          "mode": "formdata",
          "formdata": [
