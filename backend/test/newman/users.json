              "",
              "pm.test('Error says only PDF files are allowed', function () {",
              "    pm.expect(pm.response.json().message).to.include('Only PDF files are allowed');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /api/users/roll-me - postularse via CV a la vacante semillada",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jobPostingId\": 1\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/users/roll-me", "host": ["{{baseUrl}}"], "path": ["api", "users", "roll-me"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Application was logged', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.data.applicationId).to.be.a('number');",
              "    pm.expect(json.data.jobPostingId).to.eql(1);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "[NEGATIVO] POST /api/users/roll-me - ya te postulaste (misma vacante)",
      "request": {
        "method": "POST",
        "header": [
